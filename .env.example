# По умолчанию — локальная модель через Ollama, без платного ключа.
# Адрес 127.0.0.1 относится к машине, на которой запущен Python-сервис.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
LLM_TIMEOUT_SECONDS=180

# Альтернатива: LLM_PROVIDER=openai и ключ OpenAI-совместимого провайдера.
# Не коммитьте настоящий .env!
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
